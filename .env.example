# ─────────────────────────────────────────────────────────────────────────────
# Store Hub — Backend environment (.env)
# Copy this file to .env and fill in real values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─ PostgreSQL / Supabase (REQUIRED in production/full mode) ─
# The server refuses to start without SUPABASE_DB_URL. There is no SQLite fallback.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are read by config but the actual
# connection is made only via SUPABASE_DB_URL (the service role key is an API
# credential, not the database password).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# ─ Google OAuth (required for any auth flow) ─
# One OAuth client per platform. Web and Android use separate client IDs.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Redirect URIs — one per flow, required in production. In development the shared
# GOOGLE_REDIRECT_URI is accepted as a fallback, but production refuses to boot
# unless each flow has its own URI.
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback           # shared fallback (dev only)
GOOGLE_AUTH_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback       # customer sign-in
GOOGLE_ADMIN_REDIRECT_URI=https://yourdomain.com/api/admin/auth/callback       # admin sign-in
GOOGLE_DRIVE_REDIRECT_URI=https://yourdomain.com/api/drive/connect/callback    # Drive backup connect

# ─ License (cryptography) ─
# STOREHUB_PEPPER is mixed into licence code hashes. Required in production
# (min 16 chars). Development uses a well-known default if unset.
STOREHUB_PEPPER=random_32_character_hex_string
# STOREHUB_DRIVE_PEPPER is NOT used by the code — drive grants are sealed with
# STOREHUB_PEPPER. Leave unset unless you add a separate drive key later.

# ─ Drive backup ─
STOREHUB_DRIVE_FOLDER=Store Hub Backups   # folder name in customer's Drive
# STOREHUB_DRIVE=0 disables Drive entirely (default: enabled)

# ─ Session ─
STOREHUB_SESSION_TTL_MS=2592000000   # 30 days
STOREHUB_SESSION_COOKIE=storehub_session

# ─ Admin authorisation ─
# STOREHUB_ADMIN_SUB is a comma-separated list of Google account `sub` values.
# Empty = nobody is an admin (all admin routes return 403). Required in production.
STOREHUB_ADMIN_SUB=comma_separated_list_of_google_sub_values
# STOREHUB_ADMIN_PORTAL_URL is where the admin callback redirects after sign-in.
# Must be absolute https:// (http allowed only on localhost in production).
STOREHUB_ADMIN_PORTAL_URL=https://admin.yourdomain.com

# ─ Server network ─
PORT=8787
HOST=127.0.0.1                # Use 0.0.0.0 to listen on all interfaces
# STOREHUB_WEB_ROOT is the directory served as static files (default: project root)
# STOREHUB_WEB_ROOT=/var/www/storehub

# ─ CORS and proxy ─
# STOREHUB_CORS_ORIGINS is a comma-separated list of origins allowed to call the
# API with credentials. Empty = no cross-origin access (correct for same-host).
# STOREHUB_CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
# STOREHUB_TRUST_PROXY=0       # Set to '1' only behind a trusted reverse proxy

# ─ Rate limiting (per client IP, fixed window) ─
STOREHUB_RATE_WINDOW_MS=900000   # 15 minutes
STOREHUB_RATE_MAX_ACTIVATE=20    # licence activations per window
STOREHUB_RATE_MAX_VERIFY=120     # licence verifications per window

# ─ scrypt (work factor for licence code hashing) ─
STOREHUB_SCRYPT_N=16384
STOREHUB_SCRYPT_R=8
STOREHUB_SCRYPT_P=1

# ─────────────────────────────────────────────────────────────────────────────
# Notes:
# - NO secrets belong in JavaScript, the APK, the service worker, or Git.
# - SUPABASE_DB_URL and STOREHUB_PEPPER are secret: never print or log them.
# - Google OAuth clientSecret is server-side only: never in the client app.
# - The admin panel (admin/) is a separate SPA: set API_BASE in admin/config.js.
# ─────────────────────────────────────────────────────────────────────────────
