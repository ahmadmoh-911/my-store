# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here  # e.g., https://xyz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google OAuth (required for auth endpoints)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_AUTH_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback
GOOGLE_ADMIN_REDIRECT_URI=https://yourdomain.com/api/admin/auth/callback
GOOGLE_DRIVE_REDIRECT_URI=https://yourdomain.com/api/drive/connect/callback

# License Configuration
STOREHUB_PEPPER=random_32_character_hex_string
STOREHUB_DRIVE_PEPPER=random_32_character_hex_string_for_drive_encryption

# Session Configuration
STOREHUB_SESSION_TTL_MS=2592000000 # 30 days in milliseconds
STOREHUB_SESSION_COOKIE=storehub_session

# Admin Configuration
STOREHUB_ADMIN_SUB=comma_separated_list_of_google_sub_values

# Other Configuration
PORT=8787
HOST=127.0.0.1
STOREHUB_CORS_ORIGINS=
STOREHUB_TRUST_PROXY=0
STOREHUB_RATE_WINDOW_MS=900000
STOREHUB_RATE_MAX_ACTIVATE=20
STOREHUB_RATE_MAX_VERIFY=120