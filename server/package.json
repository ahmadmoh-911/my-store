{
  "name": "storehub-license-server",
  "version": "1.0.0",
  "private": true,
  "description": "Licence metadata backend for Store Hub. Stores licence and identity metadata only — never store contents.",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
